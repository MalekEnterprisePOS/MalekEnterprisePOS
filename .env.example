# ─────────────────────────────────────────────────────────────
# Malek Enterprise POS platform — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Public (safe to expose to the browser) ───────────────────
# Firebase Console > Project settings > Your apps > Web app > SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore database name. Leave EMPTY for a normal "(default)" database. If `firebase firestore:databases:list`
# shows your database as plain `default` (no parentheses), set this to: default
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=

# Public site URL (used for sitemap / Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only when running `npm run dev:demo` / `npm run build:demo` — serves fixed demo data
# instead of live Firestore reads, for showing the site without a real Firebase project connected.
NEXT_PUBLIC_DEMO_MODE=false

# ── Server only (NEVER prefix with NEXT_PUBLIC_) ─────────────
# Firebase Console > Project settings > Service accounts > Generate new private key
# Copy the three values out of the downloaded JSON. Keep the \n escapes in the key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared secret that protects /api/cron/billing (Vercel sends it as a Bearer token).
# Generate with:  openssl rand -hex 32
CRON_SECRET=

# ── Payments (leave blank until a gateway account exists) ────
# mock = local test mode. yoco = not implemented yet (see docs/ARCHITECTURE.md).
PAYMENT_PROVIDER=

# Set to a random string with `openssl rand -hex 32`. Lets a customer view their own licence key in their
# account (the key is stored encrypted, never in plain text). If unset, keys still work everywhere else -
# customers just can't look theirs up online (an admin can still see the licence in /admin/licenses).
LICENSE_KEY_ENCRYPTION_SECRET=

# TEST MODE ONLY. Set to true together with PAYMENT_PROVIDER=mock to show a "Pay now (test)" button in a
# customer's account, so you can test the buy -> pay -> licence flow end to end with no real money and no
# real gateway. Leave unset (or false) once a real gateway is connected - the button disappears entirely.
ALLOW_TEST_PAYMENTS=mock
PAYMENT_WEBHOOK_SECRET=

# ── Online card payments with Yoco (South Africa, ZAR) ───────
# Set PAYMENT_PROVIDER=yoco to turn on "Pay now" buttons, pay links in emails, and automatic licence activation.
#   1. Yoco Business Portal > Developer > API keys: copy the SECRET key (sk_test_... to try it, sk_live_... for real money).
#   2. Register the webhook once:  npm run yoco:webhook -- https://YOUR-SITE/api/webhooks/payments sk_test_xxx
#   3. Put the printed whsec_... value in YOCO_WEBHOOK_SECRET.  Test keys and live keys have DIFFERENT webhook secrets.
# PAYMENT_PROVIDER=yoco
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
# Optional: signs the "Pay now" links in emails. If blank, one is derived from CRON_SECRET.
PAY_LINK_SECRET=

# ── Email (leave blank until the sending domain is verified) ─
# Resend: https://resend.com — needs a verified domain (SPF + DKIM records).
RESEND_API_KEY=
EMAIL_FROM="Malek Enterprise POS <billing@your-domain.example>"
# Then switch on Admin > Settings > Notifications > "Deliver reminders by email". Test with Admin > Notifications > Delivery setup.

# ── Licence signing (server only) ────────────────────────────
# Ed25519 private key used to sign licence leases so the POS can verify them offline.
# Generate a pair with:  npm run signing-key   (embed the printed PUBLIC key in the POS)
LICENSE_SIGNING_PRIVATE_KEY=

# ── Secure downloads (server only) ───────────────────────────
# Signs the short-lived links behind the public Download button. Any long random string (openssl rand -hex 32).
# If you leave it blank, one is derived from your other server secrets.
DOWNLOAD_SIGNING_SECRET=
# Optional. Lets the server fetch release files from a PRIVATE GitHub repository. Needs read access to that repo's contents.
GITHUB_TOKEN=
